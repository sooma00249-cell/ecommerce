# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored — never put real secrets in this file.

# Port the API server listens on.
PORT=5000

# MongoDB connection string.
# A replica set is REQUIRED (transactions, change streams and safe writes depend on it).
#
# Local single-node replica set (see README "Running MongoDB as a replica set"):
#   mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0
#
# MongoDB Atlas:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ecommerce?retryWrites=true&w=majority
#
# If the replica set member advertises a host you cannot reach (e.g. MongoDB
# running on Windows, your app running inside WSL), add `&directConnection=true`
# so the driver talks straight to that address instead of re-resolving `me`:
#   mongodb://<HOST_IP>:27017/ecommerce?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# `development` | `test` | `production`
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
